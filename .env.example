# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT: JSON string of the Firebase Admin Service Account key.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'

# KIWIFY_WEBHOOK_SECRET: Secret path parameter for POST /api/kiwify/webhook/:segredo
KIWIFY_WEBHOOK_SECRET="SEU_SEGREDO_URL_WEBHOOK"

# KIWIFY_TOKEN: Optional token generated by Kiwify to validate ?signature= via HMAC-SHA1
KIWIFY_TOKEN="SEU_TOKEN_ASSINATURA_KIWIFY"

# KIWIFY_PLANO_ANUAL_ID: ID or name of the annual plan in Kiwify to differentiate annual vs monthly
KIWIFY_PLANO_ANUAL_ID="ID_OU_NOME_DO_PLANO_ANUAL"
